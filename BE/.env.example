# Server port (Render injects PORT automatically in production — leave unset there)
PORT=8000

# MongoDB connection string (local instance or Atlas SRV string)
MONGODB_URI=mongodb://127.0.0.1:27017/shatranj

# Long random string used to sign JWTs — generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Comma-separated list of allowed frontend origins
CLIENT_ORIGIN=http://localhost:3000
